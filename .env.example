# ---- Actual Budget ----
# Password you set when first opening the Actual web UI (http://<host>:5006).
ACTUAL_PASSWORD=change-me
# Budget "Sync ID": Actual UI -> Settings -> Advanced -> "Sync ID".
ACTUAL_SYNC_ID=
# Only if your budget file is end-to-end encrypted; otherwise leave empty.
ACTUAL_ENCRYPTION_PASSWORD=
# The Actual account id transactions are written to.
# Get it from the bridge:  curl http://localhost:5008/accounts
ACTUAL_DEFAULT_ACCOUNT_ID=

# ---- Local LLM (OpenAI-compatible: Ollama / llama.cpp / vLLM) ----
# Leave OPENAI_MODEL empty to disable the LLM and run rules-only (offline).
# Ollama example:
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OPENAI_MODEL=qwen2.5:7b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Assistant tuning ----
LOG_LEVEL=INFO
# Confidence >= this could be auto-confirmed (reserved for future automation).
AUTO_CONFIRM_THRESHOLD=0.9
# Confidence < this is flagged as "needs manual" in the review queue.
REVIEW_THRESHOLD=0.6
